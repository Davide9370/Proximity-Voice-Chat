{
	"schemaVersion": 1,
	"id": "proximityvoice",
	"version": "${version}",
	"name": "Proximity Voice",
	"description": "Proximity voice chat that travels through the normal Minecraft connection. No extra port needed. Press J for voice settings.",
	"authors": [
		"Davide Gabani"
	],
	"license": "MIT",
	"icon": "assets/proximityvoice/icon.png",
	"contact": {
		"homepage": "https://modrinth.com/mod/proximity-voice",
		"sources": "https://github.com/Davide9370/Proximity-Voice-Chat",
		"issues": "https://github.com/Davide9370/Proximity-Voice-Chat/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.proximityvoice.ProximityVoice"
		],
		"client": [
			"com.proximityvoice.client.ProximityVoiceClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
